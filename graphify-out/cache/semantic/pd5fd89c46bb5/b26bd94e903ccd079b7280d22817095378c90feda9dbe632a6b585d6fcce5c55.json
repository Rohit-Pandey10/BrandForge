{"nodes": [{"id": "design_handshake__handshake_style_reference", "label": "Handshake Style Reference", "file_type": "document", "source_file": "DESIGN(handshake).md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_handshake__voltage_lime_design_token", "label": "Voltage Lime (#d3fb52) Design Token", "file_type": "rationale", "source_file": "DESIGN(handshake).md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single chromatic ignition point in an otherwise monochrome system \u2014 used exclusively for the most important action per view (CTAs, nav pills, hero gradient endpoint). The binary monochrome + one accent approach creates maximum contrast and draws eye to action without visual noise."}, {"id": "design_handshake__noigrotesk_typography", "label": "NoiGrotesk Typography System", "file_type": "rationale", "source_file": "DESIGN(handshake).md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom grotesque with active stylistic sets ss03, ss06, ss12 that subtly shape letterforms across the entire system. Tight tracking and multiple weights (400, 500) handle all UI below 40px while the custom letterforms carry the brand identity."}, {"id": "design_handshake__sansplomb_typography", "label": "SansPlomb Display Typography", "file_type": "rationale", "source_file": "DESIGN(handshake).md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Display-only typeface used at 201px with ultra-tight 0.80 line-height. The sheer architectural scale makes the headline feel structural rather than typographic \u2014 used at most once per page to maintain its singular declaration power."}, {"id": "design_handshake__hero_gradient_banner", "label": "Hero Gradient Banner Component", "file_type": "rationale", "source_file": "DESIGN(handshake).md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-bleed radial gradient from #7af3ff to #d3fb52 fading to transparent at ~76%. The gradient is the brand signature \u2014 no other section uses this treatment, making it the atmospheric opening statement."}, {"id": "design_handshake__monochrome_plus_one_accent_pattern", "label": "Monochrome + Single Accent Design Pattern", "file_type": "rationale", "source_file": "DESIGN(handshake).md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately binary system: almost everything is black text on white surfaces, then the accent ignites. Adding a second chromatic hue breaks the binary and dilutes the impact of the primary action color."}, {"id": "design_handshake__pillow_soft_radius_system", "label": "Pillow-Soft Border Radius System", "file_type": "rationale", "source_file": "DESIGN(handshake).md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "24px on cards and inputs (soft/pillow), 8px on buttons and nav items (compact), 9999px on tags. The contrast between soft cards and compact buttons is intentional \u2014 do not reduce card radius to match button radius."}], "edges": [{"source": "design_handshake__handshake_style_reference", "target": "design_handshake__voltage_lime_design_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L14", "weight": 1.0}, {"source": "design_handshake__handshake_style_reference", "target": "design_handshake__noigrotesk_typography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L24", "weight": 1.0}, {"source": "design_handshake__handshake_style_reference", "target": "design_handshake__sansplomb_typography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L33", "weight": 1.0}, {"source": "design_handshake__handshake_style_reference", "target": "design_handshake__hero_gradient_banner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L129", "weight": 1.0}, {"source": "design_handshake__handshake_style_reference", "target": "design_handshake__monochrome_plus_one_accent_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L8", "weight": 1.0}, {"source": "design_handshake__handshake_style_reference", "target": "design_handshake__pillow_soft_radius_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L80", "weight": 1.0}, {"source": "design_handshake__voltage_lime_design_token", "target": "design_handshake__hero_gradient_banner", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L14-L15", "weight": 1.0}, {"source": "design_handshake__voltage_lime_design_token", "target": "design_handshake__monochrome_plus_one_accent_pattern", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN(handshake).md", "source_location": "L8", "weight": 1.0}, {"source": "design_handshake__monochrome_plus_one_accent_pattern", "target": "design_md_zero_chromatic_color_principle", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "DESIGN(handshake).md", "source_location": "L8", "weight": 0.75}, {"source": "design_handshake__pillow_soft_radius_system", "target": "design_md_shadow_free_elevation_princi